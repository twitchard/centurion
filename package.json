{
  "name": "centurion-chess",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:cloud": "vite --host 0.0.0.0 --open false",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cli.json",
    "test": "vitest run",
    "check": "biome check src/",
    "fix": "biome check --write src/",
    "board:cli": "bun run src/cli/render-board.ts",
    "screenshot": "bun run scripts/screenshot.ts",
    "ci:all": "bun run check && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "chessground": "^9.2.1",
    "chessops": "^0.15.0",
    "stockfish": "^18.0.7",
    "trystero": "0.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@playwright/test": "^1.58.2",
    "bun-types": "^1.3.10",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
